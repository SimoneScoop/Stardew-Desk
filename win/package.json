{
  "name": "stardew-desk",
  "productName": "Stardew Desk",
  "version": "1.2.0",
  "description": "把《星露谷物语》的农场铺到 Windows 桌面上（非官方粉丝作品）",
  "author": "SimoneScoop",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip --x64",
    "dist:setup": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "koffi": "2.9.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "local.stardewdesk.app",
    "productName": "Stardew Desk",
    "copyright": "Code © SimoneScoop (MIT). Stardew Valley © ConcernedApe — no game assets included.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui-preload.js",
      "winapi.js",
      "wavebank.js",
      "adpcm.js",
      "cities.js",
      "prompt.html",
      "audio.html",
      "icon.png",
      "tray.png",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/*.md"
    ],
    "extraResources": [
      {
        "from": "../scene",
        "to": "scene",
        "filter": [
          "**/*",
          "!data/**"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "icon": "icon.ico",
      "artifactName": "Stardew-Desk-win.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Stardew-Desk-Setup.${ext}",
      "shortcutName": "Stardew Desk"
    },
    "afterPack": "./afterpack.js",
    "extraFiles": [
      {
        "from": "使用说明.txt",
        "to": "使用说明.txt"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SimoneScoop/Stardew-Desk.git"
  }
}